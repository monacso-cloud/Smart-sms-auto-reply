<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F4F7FB">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="Test Your Bot" android:textSize="28sp" android:textStyle="bold" android:textColor="#0B1F3A"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:text="Type a message exactly as a customer might send it. ReplyDesk will show which keyword matched and which reply would be sent."
      android:textColor="#526278"/>
  <EditText android:id="@+id/testMessageInput" android:layout_width="match_parent" android:layout_height="120dp"
      android:layout_marginTop="16dp" android:gravity="top|start" android:background="#FFFFFF" android:padding="14dp" android:inputType="textMultiLine"/>
  <Button android:id="@+id/runTestButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Test Message"/>
  <TextView android:id="@+id/testBotResult" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="16dp" android:background="#E7F0FF" android:padding="16dp" android:textColor="#123966"/>
</LinearLayout>