<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F4F7FB">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="Call Logs" android:textSize="28sp" android:textStyle="bold" android:textColor="#0B1F3A"/>
  <Spinner android:id="@+id/callLogPeriodSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:entries="@array/call_log_period_labels"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/refreshCallLogsButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Refresh"/>
    <Button android:id="@+id/clearCallLogsButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Clear Logs"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp">
    <TextView android:id="@+id/callLogText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="14dp" android:textColor="#16263D"/>
  </ScrollView>
</LinearLayout>