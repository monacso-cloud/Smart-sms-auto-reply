<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4F7FB">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ReplyDesk" android:textSize="30sp" android:textStyle="bold" android:textColor="#0B1F3A"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Set up ReplyDesk step by step. Start with Auto Reply, then add your Keywords &amp; Replies, choose your Schedule, check Call Logs, and use Test Your Bot before going live."
        android:textSize="16sp" android:textColor="#526278"/>
    <Button android:id="@+id/openAutoReplyButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="24dp" android:text="Auto Reply"/>
    <Button android:id="@+id/openKeywordsButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Keywords &amp; Replies"/>
    <Button android:id="@+id/openScheduleButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Reply Schedule"/>
    <Button android:id="@+id/openCallLogsButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Call Logs"/>
    <Button android:id="@+id/openTestBotButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Test Your Bot"/>
    <Button android:id="@+id/openExistingButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Advanced Existing Settings"/>
  </LinearLayout>
</ScrollView>