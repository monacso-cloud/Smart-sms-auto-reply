<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FB" android:fillViewport="true" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/replydesk_logo" android:contentDescription="ReplyDesk logo"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ReplyDesk" android:textSize="28sp" android:textColor="#102D4D" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Business SMS Bot" android:textSize="14sp" android:textColor="#102D4D" />
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="22dp" android:background="@drawable/rd_hero">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR REPLY DESK" android:letterSpacing="0.12" android:textSize="12sp" android:textColor="#AEEAE5"/>
<TextView android:id="@+id/dashboardReplyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Reply settings" android:textColor="#FFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-medium"/>
<TextView android:id="@+id/dashboardReplyDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#DBECF9" android:textSize="15sp" android:lineSpacingExtra="4dp"/>
<Button android:id="@+id/openAutoReplyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="20dp" android:text="Set up my reply messages" android:backgroundTint="#BAF3E7" android:textColor="#123F4A"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Make it yours" android:textSize="21sp" android:textColor="#102D4D" android:layout_marginTop="26dp" android:fontFamily="sans-serif-medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Simple replies first. Add a chatbot when you need one." android:textSize="14sp" android:textColor="#102D4D" android:layout_marginTop="6dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/openMenuButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Menu &amp;\nquick replies"/><Space android:layout_width="12dp" android:layout_height="1dp"/><Button android:id="@+id/openKeywordsButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Keywords &amp;\nanswers"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/openScheduleButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Business hours\n&amp; schedule"/><Space android:layout_width="12dp" android:layout_height="1dp"/><Button android:id="@+id/openTestBotButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Try a message\nPreview a reply"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage" android:textSize="21sp" android:textColor="#102D4D" android:layout_marginTop="26dp" android:fontFamily="sans-serif-medium"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/openCallLogsButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Call &amp;\nreply history"/><Space android:layout_width="12dp" android:layout_height="1dp"/><Button android:id="@+id/openExistingButton" style="@style/ReplyDeskTile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="92dp" android:text="Phone, SIM &amp;\nadvanced settings"/></LinearLayout>
<Button android:id="@+id/openAccountButton" style="@style/ReplyDeskTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginTop="12dp" android:text="Account &amp; subscription"/>
<Button android:id="@+id/openLegalButton" style="@style/ReplyDeskTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:layout_marginTop="12dp" android:text="Privacy, terms &amp; support"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ReplyDesk Pro · Coming soon" android:textSize="13sp" android:textColor="#102D4D" android:layout_marginTop="24dp" android:gravity="center"/>
</LinearLayout></ScrollView>