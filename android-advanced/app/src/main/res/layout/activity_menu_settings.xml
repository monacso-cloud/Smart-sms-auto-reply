<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FB">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Menu &amp; Quick Replies" android:textSize="28sp" android:textStyle="bold" android:textColor="#0B1F3A"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use this section if you want customers to reply with 1, 2, 3 or 4. Change every menu label and reply to suit your business. The examples below are only a starting template."
        android:textColor="#526278" android:textSize="15sp"/>
    <Switch android:id="@+id/menuEnabledSwitch" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="12dp" android:text="Enable numbered menu"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Menu introduction" android:textStyle="bold" android:layout_marginTop="10dp"/>
    <EditText android:id="@+id/menuIntroInput" android:layout_width="match_parent" android:layout_height="90dp"
        android:background="#FFFFFF" android:gravity="top|start" android:padding="12dp" android:inputType="textMultiLine"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="1 — Menu label" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/menuItem1Input" android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:padding="12dp"/>
    <EditText android:id="@+id/menuReply1Input" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="6dp" android:background="#FFFFFF" android:gravity="top|start" android:padding="12dp" android:inputType="textMultiLine"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="2 — Menu label" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/menuItem2Input" android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:padding="12dp"/>
    <EditText android:id="@+id/menuReply2Input" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="6dp" android:background="#FFFFFF" android:gravity="top|start" android:padding="12dp" android:inputType="textMultiLine"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="3 — Menu label" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/menuItem3Input" android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:padding="12dp"/>
    <EditText android:id="@+id/menuReply3Input" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="6dp" android:background="#FFFFFF" android:gravity="top|start" android:padding="12dp" android:inputType="textMultiLine"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="4 — Menu label" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/menuItem4Input" android:layout_width="match_parent" android:layout_height="56dp" android:background="#FFFFFF" android:padding="12dp"/>
    <EditText android:id="@+id/menuReply4Input" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="6dp" android:background="#FFFFFF" android:gravity="top|start" android:padding="12dp" android:inputType="textMultiLine"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tip: Replace [PRICE], [WEBSITE], [BUSINESS ADDRESS] and other placeholders with your own information."
        android:textColor="#526278" android:textSize="14sp"/>
    <Button android:id="@+id/saveMenuButton" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="20dp" android:text="Save Menu"/>
  </LinearLayout>
</ScrollView>